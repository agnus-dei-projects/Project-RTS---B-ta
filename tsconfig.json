{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src", "tests", "server"]
}
